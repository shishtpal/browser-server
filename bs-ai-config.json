{
    "cors_enabled": false,
    "default_provider": "openrouter.ai",
    "chat": {
        "system_prompt": "You are `bs` a helpful assistant integrated into browser-server. Use multi_edit for related literal find/replace changes across existing files so they apply atomically. Always use read_file first and copy find text exactly, including indentation and newlines. Make find text unique with surrounding context, and use all only when every occurrence should change. Batch related edits into one multi_edit call, use an empty replacement to delete text, and use write_file for new files. After a no_match result, read the file again instead of retrying guessed content.",
        "max_history_messages": 30,
        "stream": true,
        "show_thinking": true,
        "temperature": 0.7,
        "tool_retry_attempts": 10,
        "tool_retry_delay_seconds": 5,
        "attachments": {
            "enabled": true,
            "allowed_mime_types": [
                "image/png",
                "image/jpeg",
                "image/webp",
                "image/gif"
            ],
            "max_images": 5,
            "max_image_bytes": 5242880,
            "max_total_bytes": 20971520,
            "retention_hours": 24
        }
    },
    "paths": {
        "additional_dirs": [],
        "binaries": {}
    },
    "tools": {
        "enabled": true,
        "max_output": 32768,
        "max_diff_output": 32768,
        "git_timeout_seconds": 30,
        "max_iterations": 100,
        "raw_output": [
            "recall_memory",
            "read_file",
            "read_files",
            "ask_questions",
            "git_diff",
            "directory_tree",
            "write_file",
            "delete_file",
            "copy_file",
            "move_file",
            "edit_file",
            "list_directory",
            "web_search",
            "web_fetch",
            "search_code",
            "search_questions",
            "execute_python"
        ],
        "allowed": [
            "search_tool",
            "get_current_time",
            "ask_questions",
            "search_questions",
            "manage_question",
            "search_todos",
            "add_todo_record",
            "update_todo_record",
            "search_prompts",
            "manage_prompt",
            "search_calendar",
            "manage_calendar",
            "search_bookmarks",
            "search_history",
            "web_search",
            "web_fetch",
            "execute_command",
            "execute_python",
            "generate_image",
            "text_to_speech",
            "ocr_image",
            "read_file",
            "read_files",
            "write_file",
            "edit_file",
            "multi_edit",
            "list_directory",
            "delete_file",
            "move_file",
            "copy_file",
            "directory_tree",
            "search_code",
            "analyze_code",
            "get_diagnostics",
            "git_status",
            "git_diff",
            "git_log",
            "git_branch",
            "git_checkout",
            "git_commit",
            "git_push",
            "git_pull",
            "git_merge",
            "recall_memory",
            "write_memory",
            "list_skills",
            "activate_skill",
            "deactivate_skill",
            "get_active_skills"
        ]
    },
    "web_search": {
        "enabled": true,
        "default_provider": "auto",
        "timeout_seconds": 30,
        "max_results": 10,
        "fallback": true,
        "cache_ttl_minutes": 5,
        "cache_max_entries": 100,
        "providers": {
            "brave": {
                "enabled": false,
                "api_key": "env:BRAVE_API_KEY"
            },
            "tavily": {
                "enabled": false,
                "api_key": "env:TAVILY_API_KEY"
            },
            "google": {
                "enabled": false,
                "api_key": "env:GOOGLE_API_KEY",
                "search_engine_id": "env:GOOGLE_CSE_ID"
            },
            "searxng": {
                "enabled": false,
                "base_url": "http://localhost:8888"
            },
            "duckduckgo": {
                "enabled": true
            }
        }
    },
    "logging": {
        "enabled": true,
        "db_path": ".data/bs-ai.db",
        "retention_days": 60,
        "log_full_payload": true,
        "max_payload_bytes": 1048576
    },
    "memory": {
        "enabled": true,
        "directory": ".memory",
        "fragments_dir": "fragments",
        "archive_dir": ".archive",
        "max_body_kb": 64,
        "max_links_per_fragment": 64,
        "max_ops_per_call": 20,
        "max_result_bytes": 8192,
        "default_depth": 1,
        "max_depth": 3,
        "spread_factor": 0.45,
        "persona_token_budget": 900,
        "inject_persona": true,
        "inject_usage_guide": true,
        "retention_days": 365,
        "auto_cleanup": true,
        "maintenance_interval": "6h",
        "salience_decay_per_week": 0.985,
        "archive_threshold": 0.15,
        "secret_scan": true,
        "near_duplicate_threshold": 0.82,
        "synthesizer": {
            "enabled": true,
            "provider": "openrouter.ai",
            "model": "openai/gpt-4o-mini",
            "temperature": 0.2,
            "max_output_tokens": 512,
            "timeout_ms": 8000,
            "fallback_on_error": true
        },
        "embeddings": {
            "enabled": false,
            "provider": "",
            "model": "",
            "dims": 384
        }
    },
    "file_tools": {
        "max_read_bytes": 32768,
        "max_line_read_bytes": 65536,
        "max_line_count": 5000,
        "max_file_size_warn_mb": 100,
        "allowed_extensions": [],
        "blocked_path_patterns": [
            "**/.env*",
            "**/*.pem",
            "**/*.key",
            "**/node_modules/**",
            "**/.git/**",
            "**/bs-ai-models.json"
        ]
    },
    "skills": {
        "enabled": true,
        "directory": ".skills"
    },
    "ocr": {
        "enabled": true,
        "default_provider": "openrouter.ai",
        "default_model": "openai/gpt-4o-mini",
        "max_input_bytes": 20971520,
        "output_dir": "",
        "poppler": {
            "dir": "",
            "dpi": 150,
            "format": "png",
            "max_pages": 32,
            "timeout_seconds": 120
        }
    },
    "openrouter": {
        "site_url": "https://github.com/shishtpal/browser-server",
        "app_name": "Browser Server"
    }
}
