{
    "cors_enabled": false,
    "default_provider": "openrouter",
    "chat": {
        "system_prompt": "You are `bs` a helpful assistant integrated into browser-server. Use multi_edit for related literal find/replace changes across existing files so they apply atomically. Always use read_file first and copy find text exactly, including indentation and newlines. Make find text unique with surrounding context, and use all only when every occurrence should change. Batch related edits into one multi_edit call, use an empty replacement to delete text, and use write_file for new files. After a no_match result, read the file again instead of retrying guessed content.",
        "max_history_messages": 30,
        "stream": true,
        "temperature": 0.7,
        "tool_retry_attempts": 10,
        "tool_retry_delay_seconds": 5,
        "attachments": {
            "enabled": true,
            "allowed_mime_types": [
                "image/png",
                "image/jpeg",
                "image/webp",
                "image/gif"
            ],
            "max_images": 5,
            "max_image_bytes": 5242880,
            "max_total_bytes": 20971520,
            "retention_hours": 24
        }
    },
    "paths": {
        "additional_dirs": [],
        "binaries": {}
    },
    "tools": {
        "enabled": true,
        "max_output": 32768,
        "max_diff_output": 32768,
        "git_timeout_seconds": 30,
        "max_iterations": 100,
        "raw_output": [
            "read_file",
            "ask_questions",
            "git_diff",
            "directory_tree",
            "write_file",
            "delete_file",
            "copy_file",
            "move_file",
            "edit_file",
            "list_directory",
            "web_search",
            "web_fetch",
            "search_code",
            "execute_python"
        ],
        "allowed": [
            "search_tool",
            "get_current_time",
            "ask_questions",
            "search_todos",
            "add_todo_record",
            "update_todo_record",
            "search_prompts",
            "manage_prompt",
            "search_calendar",
            "manage_calendar",
            "search_bookmarks",
            "search_history",
            "web_search",
            "web_fetch",
            "execute_command",
            "execute_python",
            "generate_image",
            "read_file",
            "write_file",
            "edit_file",
            "multi_edit",
            "list_directory",
            "delete_file",
            "move_file",
            "copy_file",
            "directory_tree",
            "search_code",
            "analyze_code",
            "get_diagnostics",
            "git_status",
            "git_diff",
            "git_log",
            "git_branch",
            "git_checkout",
            "git_commit",
            "git_push",
            "git_pull",
            "git_merge",
            "ai_remember",
            "ai_recall",
            "ai_search_memory",
            "ai_list_memories",
            "ai_forget",
            "ai_update_memory",
            "ai_resolve_references",
            "ai_lazy_memory",
            "ai_manage_cache",
            "list_skills",
            "activate_skill",
            "deactivate_skill",
            "get_active_skills"
        ]
    },
    "web_search": {
        "enabled": true,
        "default_provider": "auto",
        "timeout_seconds": 30,
        "max_results": 10,
        "fallback": true,
        "cache_ttl_minutes": 5,
        "cache_max_entries": 100,
        "providers": {
            "brave": {
                "enabled": false,
                "api_key": "env:BRAVE_API_KEY"
            },
            "tavily": {
                "enabled": false,
                "api_key": "env:TAVILY_API_KEY"
            },
            "google": {
                "enabled": false,
                "api_key": "env:GOOGLE_API_KEY",
                "search_engine_id": "env:GOOGLE_CSE_ID"
            },
            "searxng": {
                "enabled": false,
                "base_url": "http://localhost:8888"
            },
            "duckduckgo": {
                "enabled": true
            }
        }
    },
    "logging": {
        "enabled": true,
        "db_path": ".data/bs-ai.db",
        "retention_days": 60,
        "log_full_payload": true,
        "max_payload_bytes": 1048576
    },
    "memory": {
        "directory": ".memory",
        "primary_dir": "memories",
        "refs_dir": "refs",
        "cache_dir": "cache",
        "max_file_size_kb": 1024,
        "retention_days": 365,
        "auto_cleanup": true,
        "max_reference_depth": 5,
        "lazy_loading": true,
        "cache_size_limit_mb": 100
    },
    "file_tools": {
        "max_read_bytes": 32768,
        "max_line_read_bytes": 65536,
        "max_line_count": 5000,
        "max_file_size_warn_mb": 100,
        "allowed_extensions": [],
        "blocked_path_patterns": [
            "**/.env*",
            "**/*.pem",
            "**/*.key",
            "**/node_modules/**",
            "**/.git/**",
            "**/bs-ai-models.json"
        ]
    },
    "skills": {
        "enabled": true,
        "directory": ".skills"
    }
}