      "type": "sarvam_streaming",
      "enabled": true,
      "base_url": "wss://api.sarvam.ai/speech-to-text/ws",
      "api_key": "env:SARVAM_API_KEY",
      "request_timeout_seconds": 150,
      "models": [
        {
          "id": "saaras:v4",
          "label": "Saaras v4",
          "sample_rate": 16000,
          "mode": "transcribe",
          "input_audio_codec": "pcm_s16le",
          "default": true
        }
      ]
    }
  }
}
