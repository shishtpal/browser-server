{
    "type": "object",
    "properties": {
        "user_id": {
            "type": "integer",
            "minimum": 1
        },
        "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
        },
        "description": {
            "type": "string",
            "maxLength": 2000
        },
        "start_date": {
            "type": "string",
            "description": "Start date (YYYY-MM-DD or RFC3339)"
        },
        "end_date": {
            "type": "string",
            "description": "End date (YYYY-MM-DD or RFC3339)"
        },
        "rrule": {
            "type": "string",
            "description": "Recurrence rule (e.g. RRULE:FREQ=WEEKLY;COUNT=5)"
        },
        "priority": {
            "type": "string",
            "enum": [
                "low",
                "medium",
                "high",
                "urgent"
            ]
        },
        "status": {
            "type": "string",
            "enum": [
                "pending",
                "completed",
                "archived"
            ]
        },
        "color": {
            "type": "string"
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "user_id",
        "title",
        "start_date"
    ],
    "additionalProperties": false
}
