{
    "type": "object",
    "properties": {
        "user_id": {
            "type": "integer",
            "minimum": 1,
            "description": "User ID must be a positive integer"
        },
        "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Title must be 1-500 characters"
        },
        "description": {
            "type": "string",
            "maxLength": 2000,
            "description": "Description must be 2000 characters or fewer"
        },
        "parent_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Parent todo ID must be a positive integer"
        },
        "priority": {
            "type": "string",
            "enum": [
                "low",
                "medium",
                "high",
                "urgent"
            ],
            "description": "Priority must be one of: low, medium, high, urgent"
        },
        "status": {
            "type": "string",
            "enum": [
                "pending",
                "in_progress",
                "completed",
                "done",
                "cancelled",
                "archived"
            ],
            "description": "Status must be one of: pending, in_progress, completed, done, cancelled, archived"
        },
        "color": {
            "type": "string",
            "pattern": "^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
            "description": "Color must be a valid hex color code (e.g., #FF5733, #33FF57, FF5733, or 33FF57)"
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string",
                "maxLength": 100
            },
            "description": "Each tag must be 100 characters or fewer"
        },
        "start_date": {
            "type": "string",
            "description": "Start date (YYYY-MM-DD or RFC3339)"
        },
        "end_date": {
            "type": "string",
            "description": "End date (YYYY-MM-DD or RFC3339)"
        },
        "subtasks": {
            "type": "array",
            "maxItems": 20,
            "items": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "maxLength": 500,
                        "description": "Subtask title must be 500 characters or fewer"
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 2000,
                        "description": "Subtask description must be 2000 characters or fewer"
                    },
                    "priority": {
                        "type": "string",
                        "enum": [
                            "low",
                            "medium",
                            "high",
                            "urgent"
                        ],
                        "description": "Subtask priority must be one of: low, medium, high, urgent"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "pending",
                            "in_progress",
                            "completed",
                            "done",
                            "cancelled",
                            "archived"
                        ],
                        "description": "Subtask status must be one of: pending, in_progress, completed, done, cancelled, archived"
                    },
                    "color": {
                        "type": "string",
                        "pattern": "^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
                        "description": "Subtask color must be a valid hex color code"
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 100
                        },
                        "description": "Each subtask tag must be 100 characters or fewer"
                    }
                },
                "additionalProperties": false
            },
            "description": "Maximum 20 subtasks allowed"
        }
    },
    "required": [
        "user_id",
        "title"
    ],
    "additionalProperties": false
}
