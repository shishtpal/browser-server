{
    "type": "object",
    "properties": {
        "user_id": {
            "type": "integer",
            "minimum": 1
        },
        "action": {
            "type": "string",
            "enum": [
                "add",
                "edit",
                "remove",
                "get"
            ],
            "description": "Action to perform: add, edit, remove, or get a calendar event"
        },
        "id": {
            "type": "integer",
            "minimum": 1,
            "description": "Calendar event ID (required for edit, remove, and get actions)"
        },
        "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
        },
        "description": {
            "type": "string",
            "maxLength": 2000
        },
        "start_date": {
            "type": "string",
            "description": "Start date (YYYY-MM-DD or RFC3339)"
        },
        "end_date": {
            "type": "string",
            "description": "End date (YYYY-MM-DD or RFC3339)"
        },
        "rrule": {
            "type": "string",
            "description": "Recurrence rule (e.g. RRULE:FREQ=WEEKLY;COUNT=5)"
        },
        "priority": {
            "type": "string",
            "enum": [
                "low",
                "medium",
                "high",
                "urgent"
            ]
        },
        "status": {
            "type": "string",
            "enum": [
                "pending",
                "in_progress",
                "completed",
                "done",
                "cancelled",
                "archived"
            ]
        },
        "color": {
            "type": "string",
            "description": "Hex color code (e.g. #3366FF). Defaults to #3366FF if not provided"
        },
        "domain": {
            "type": "string",
            "description": "Associated domain for the calendar event"
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "user_id",
        "action"
    ],
    "additionalProperties": false
}