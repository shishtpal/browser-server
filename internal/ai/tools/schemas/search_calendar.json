{
    "type": "object",
    "properties": {
        "user_id": {
            "type": "integer",
            "minimum": 1
        },
        "query": {
            "type": "string",
            "maxLength": 200
        },
        "from": {
            "type": "string",
            "description": "Start of date range (YYYY-MM-DD)"
        },
        "to": {
            "type": "string",
            "description": "End of date range (YYYY-MM-DD)"
        },
        "status": {
            "type": "string",
            "enum": [
                "pending",
                "in_progress",
                "done",
                "cancelled"
            ]
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string",
                "maxLength": 100
            },
            "description": "Filter by exact tags. Every requested tag must be present on a returned event (AND semantics); matching is case-sensitive and never matches substrings. Results include each event's tags and a relevance score."
        },
        "page": {
            "type": "integer",
            "minimum": 1,
            "description": "One-based page number. Defaults to 1."
        },
        "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Number of results per page. Defaults to 10; maximum is 100."
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Deprecated. Use page_size instead. If page_size is omitted, limit is used as the page size."
        }
    },
    "required": [
        "user_id"
    ],
    "additionalProperties": false
}
