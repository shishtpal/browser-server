{
    "type": "object",
    "properties": {
        "pattern": {
            "type": "string",
            "maxLength": 500
        },
        "path": {
            "type": "string"
        },
        "include": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "exclude": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "case_sensitive": {
            "type": "boolean"
        },
        "whole_word": {
            "type": "boolean"
        },
        "page": {
            "type": "integer",
            "minimum": 1,
            "description": "One-based page number. Defaults to 1."
        },
        "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Number of results per page. Defaults to 10; maximum is 100."
        },
        "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Deprecated. Use page_size instead. If page_size is omitted, max_results is used as the page size."
        },
        "context_lines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
        },
        "type": {
            "type": "string",
            "enum": [
                "regex",
                "literal",
                "fixed"
            ]
        }
    },
    "required": [
        "pattern"
    ],
    "additionalProperties": false
}
