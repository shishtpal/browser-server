{
    "type": "object",
    "properties": {
        "user_id": {
            "type": "integer",
            "minimum": 1
        },
        "query": {
            "type": "string",
            "maxLength": 200
        },
        "page": {
            "type": "integer",
            "minimum": 1,
            "description": "One-based page number. Defaults to 1."
        },
        "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Number of results per page. Defaults to 10; maximum is 100."
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Deprecated. Use page_size instead. If page_size is omitted, limit is used as the page size."
        }
    },
    "required": [
        "user_id"
    ],
    "additionalProperties": false
}
