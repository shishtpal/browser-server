{
    "type": "object",
    "properties": {
        "user_id": {
            "type": "integer",
            "minimum": 1
        },
        "query": {
            "type": "string",
            "maxLength": 200
        },
        "status": {
            "type": "string",
            "enum": [
                "pending",
                "in_progress",
                "completed",
                "archived"
            ]
        },
        "priority": {
            "type": "string",
            "enum": [
                "low",
                "medium",
                "high",
                "urgent"
            ]
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string",
                "maxLength": 100
            },
            "description": "Filter by exact tags. Every requested tag must be present on a returned todo (AND semantics); matching is case-sensitive and never matches substrings. Results include each todo's tags."
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
        }
    },
    "required": [
        "user_id"
    ],
    "additionalProperties": false
}